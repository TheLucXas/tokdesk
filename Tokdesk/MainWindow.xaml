<Window x:Class="Tokdesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Tokdesk" Icon="pack://application:,,,/app.ico" Width="440" Height="860" MinWidth="300" MinHeight="500"
        Background="#000000" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- El margen deja un borde propio de la ventana para poder redimensionarla -->
    <Grid x:Name="Root" Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Encabezado al mostrar una página oficial: flecha de volver al estilo de la app -->
        <Border x:Name="LoginBar" Grid.Row="0" Visibility="Collapsed" Background="#000000" Height="46"
                BorderBrush="#1F1F1F" BorderThickness="0,0,0,1">
            <Grid>
                <Button x:Name="DoneButton" HorizontalAlignment="Left" Click="DoneButton_Click" Cursor="Hand"
                        ToolTip="Volver a la app">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="10,0,14,0" Margin="4,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M9,1 L2,8 L9,15" Stroke="White" StrokeThickness="2.2" Width="11" Height="16"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,8,0" />
                                    <TextBlock Text="Volver" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                               FontFamily="Segoe UI Variable Text, Segoe UI" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#1F1F1F" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="PanelText" Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI Variable Text, Segoe UI" />
            </Grid>
        </Border>

        <wv2:WebView2 x:Name="Ui" Grid.Row="1" DefaultBackgroundColor="Black" />
        <Border x:Name="EngineHost" Grid.Row="1" Background="Transparent" IsHitTestVisible="False" />
    </Grid>
</Window>
