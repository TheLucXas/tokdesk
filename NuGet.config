<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Los paquetes se guardan dentro del proyecto, no en el perfil del usuario -->
    <add key="globalPackagesFolder" value="tools\nuget" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
